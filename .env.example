# Public URL of the site (canonical URLs, sitemaps, Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://www.macrosnaps.com

# Stripe (Dashboard > Developers > API keys). Without it, bookings are emailed as unpaid requests.
STRIPE_SECRET_KEY=sk_live_...
# Stripe webhook endpoint https://www.macrosnaps.com/api/stripe-webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (resend.com) for booking + contact emails. Verify macrosnaps.com there first.
RESEND_API_KEY=re_...
MAIL_FROM=MacroSnaps <bookings@macrosnaps.com>
TEAM_INBOX=info@macrosnaps.com
